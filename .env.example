# URL e chaves do projeto Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Secreta — nunca prefixar com NEXT_PUBLIC_, nunca expor ao client
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Secreta — protege POST /api/internal/purge-inactive-rooms (expurgo por
# inatividade). Gere um valor aleatório (ex.: `openssl rand -hex 32`) e
# configure o mesmo valor no scheduler que chama o endpoint.
CRON_SECRET=...
