# URL e chaves do projeto Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Secreta — nunca prefixar com NEXT_PUBLIC_, nunca expor ao client
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Domínios permitidos para o link do ticket (separados por vírgula). Só https
# e hosts desta lista são aceitos — evita que o campo vire vetor de XSS/
# phishing (ver types/api.ts). Se omitido, usa apenas "jira.xcl.digital".
ALLOWED_TICKET_URL_HOSTS=jira.xcl.digital
